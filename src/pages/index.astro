---
import "../styles/global.css";
import homepage from "../content/homepage/homepage.json";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>JM Heights Contractor & HVAC</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50">
    <header class="bg-white shadow-sm sticky top-0 z-20">
      <div
        class="max-w-6xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8 py-4"
      >
        <a href="#top" class="flex items-center gap-2">
          <div
            class="h-9 w-9 rounded-full bg-brand text-white flex items-center justify-center font-bold"
          >
            JM Heights
          </div>
          <span class="font-semibold text-slate-900">
            Contractor & HVAC Solutions
          </span>
        </a>
        <nav class="hidden sm:flex gap-6 text-sm font-medium text-slate-700">
          <a href="#about" class="hover:text-brand">About</a>
          <a href="#services" class="hover:text-brand">Services</a>
          <a href="#contact" class="hover:text-brand">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top" class="flex-1">
      <!-- Hero -->
      <section class="section bg-gradient-to-b from-white to-slate-100">
        <div class="section-inner grid gap-10 lg:grid-cols-2 items-center">
          <div>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-4">
              {homepage.heroTitle}
            </h1>
            <p class="text-lg text-slate-600 mb-6">
              {homepage.heroSubtitle}
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="#contact" class="btn-primary">
                Request a quote
              </a>
              <a
                href="#services"
                class="inline-flex items-center text-sm font-semibold text-brand hover:text-brand-dark"
              >
                View services
              </a>
            </div>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 border border-slate-100">
            <h2 class="text-lg font-semibold mb-3 text-slate-900">
              Why clients choose us
            </h2>
            <ul class="space-y-3 text-sm text-slate-700">
              <li>• Licensed and insured general contractors</li>
              <li>• Clear, written estimates and timelines</li>
              <li>• Clean job sites and respectful crews</li>
              <li>• Residential and commercial experience</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- About -->
      <section id="about" class="section bg-white">
        <div class="section-inner">
          <h2 class="section-title">{homepage.aboutTitle}</h2>
          <p class="section-subtitle max-w-3xl">
            {homepage.aboutBody}
          </p>
        </div>
      </section>

      <!-- Services -->
      <section id="services" class="section bg-slate-50">
        <div class="section-inner">
          <h2 class="section-title">{homepage.servicesTitle}</h2>
          <p class="section-subtitle max-w-3xl">
            {homepage.servicesIntro}
          </p>

          <div class="grid gap-6 md:grid-cols-2">
            {homepage.services.map((service) => (
              <article class="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
                <h3 class="text-lg font-semibold text-slate-900 mb-1">
                  {service.name}
                </h3>
                <p class="text-sm text-slate-600">
                  {service.description}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="section bg-white">
        <div class="section-inner grid gap-10 lg:grid-cols-[2fr,1.3fr]">
          <div>
            <h2 class="section-title">{homepage.contactTitle}</h2>
            <p class="section-subtitle max-w-2xl">
              {homepage.contactSubtitle}
            </p>

            <form
              class="bg-slate-50 border border-slate-200 rounded-xl p-6 space-y-4"
              method="POST"
              action="https://formspree.io/f/your-cloudflare-form-endpoint"
            >
              <input type="hidden" name="form-name" value="contact" />

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">
                  Name
                </label>
                <input
                  type="text"
                  name="name"
                  required
                  class="block w-full rounded-md border-slate-300 shadow-sm focus:border-brand focus:ring-brand text-sm px-3 py-2 bg-white"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">
                  Email
                </label>
                <input
                  type="email"
                  name="email"
                  required
                  class="block w-full rounded-md border-slate-300 shadow-sm focus:border-brand focus:ring-brand text-sm px-3 py-2 bg-white"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">
                  Phone (optional)
                </label>
                <input
                  type="tel"
                  name="phone"
                  class="block w-full rounded-md border-slate-300 shadow-sm focus:border-brand focus:ring-brand text-sm px-3 py-2 bg-white"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">
                  Project details
                </label>
                <textarea
                  name="message"
                  required
                  rows="4"
                  class="block w-full rounded-md border-slate-300 shadow-sm focus:border-brand focus:ring-brand text-sm px-3 py-2 bg-white"
                ></textarea>
              </div>

              <button type="submit" class="btn-primary">
                Send message
              </button>
            </form>
          </div>

          <aside class="space-y-4 text-sm text-slate-700">
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
              <h3 class="text-base font-semibold text-slate-900 mb-2">
                Service area
              </h3>
              <p>Queens, Brooklyn, Manhattan, and surrounding New York City areas.</p>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
              <h3 class="text-base font-semibold text-slate-900 mb-2">
                Contact info
              </h3>
              <p>Phone: (555) 123‑4567</p>
              <p>Email: info@examplecontractor.com</p>
            </div>
          </aside>
        </div>
      </section>
    </main>

    <footer class="bg-slate-900 text-slate-300 text-sm">
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3"
      >
        <p>© {new Date().getFullYear()} General Contracting Co. All rights reserved.</p>
        <a href="/admin" class="hover:text-white">Admin login</a>
      </div>
    </footer>
  </body>
</html>
