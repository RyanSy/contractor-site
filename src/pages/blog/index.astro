---
import "../../styles/global.css";
import { glob } from "astro/loaders";

const posts = await glob("../../content/blog/*.md");
---

<html lang="en">
  <body class="section">
    <div class="section-inner space-y-8">
      <h1 class="section-title">Blog</h1>

      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="block p-5 bg-white rounded-lg shadow-sm border border-slate-200 hover:shadow">
          <h2 class="text-xl font-semibold">{post.title}</h2>
          <p class="text-slate-600">{new Date(post.date).toLocaleDateString()}</p>
        </a>
      ))}
    </div>
  </body>
</html>
