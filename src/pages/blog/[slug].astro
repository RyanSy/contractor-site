---
import "../../styles/global.css";
const { title, date, featuredImage, body } = Astro.props;
---

<html lang="en">
  <body class="section">
    <div class="section-inner space-y-6 max-w-3xl">
      <h1 class="text-3xl font-bold">{title}</h1>
      <p class="text-slate-500">{new Date(date).toLocaleDateString()}</p>

      {featuredImage && (
        <img src={featuredImage} class="rounded-lg shadow" />
      )}

      <article class="prose prose-slate" set:html={body} />
    </div>
  </body>
</html>
